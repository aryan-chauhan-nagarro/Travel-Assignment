# Firebase Configuration Example
# Replace with your Firebase project credentials from Firebase Console -> Project Settings -> General -> Web Apps
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Demo Credentials for testing & evaluation
DEMO_ADMIN_EMAIL=admin@travelbooking.com
DEMO_ADMIN_PASSWORD=AdminPassword123!
DEMO_USER_EMAIL=user@travelbooking.com
DEMO_USER_PASSWORD=UserPassword123!
